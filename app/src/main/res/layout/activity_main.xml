<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!--PASO 4- AÑADIMOS LA ETIQUEYA DATA -->
    <!-- Declaramos las clases y el modelo que vamos a usar en las expresiones del XML -->
    <data>
        <import type="android.view.View" />
        <import type="es.davante.edadcanina.modelo.Validacion" />
        <variable
            name="modelo"
            type="es.davante.edadcanina.modelo.EdadCaninaModelo" />
        <variable
            name="controlador"
            type="es.davante.edadcanina.controlador.EdadCaninaControlador" />
    </data>

<androidx.appcompat.widget.LinearLayoutCompat
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:ignore="ExtraText">


<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textSize="32sp"
    android:gravity="center"
    android:layout_marginTop="32dp"
    android:text="@string/txt_titulo">

</TextView>

    <ImageView
        android:layout_width="192dp"
        android:layout_height="wrap_content"
        android:src="@drawable/imgdog"
        android:adjustViewBounds="true"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/input_age"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:gravity="center"
        />

    <!-- PASO 4: Enlace bidireccional (@={...}) -->
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="48sp"
        android:hint="@string/hint_edad"
        android:id="@+id/age_input"
        android:inputType="number"
        android:maxLength="2"
        android:gravity="center"
        android:importantForAutofill="no"
        android:text="@={modelo.edadTexto}"
        app:errorValidacion="@{modelo.validacion}"
        />

    <!-- PASO 4: Se pinta solo al calcular y usa INVISIBLE (no GONE)-->
 <TextView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:textSize="16sp"
     android:gravity="center"
     android:layout_marginTop="20dp"
     android:id="@+id/result_text"
     android:text="@{@string/tu_edad_format(modelo.edadHumana)}"
     android:visibility="@{modelo.validacion == Validacion.OK ? View.VISIBLE : View.INVISIBLE}"
     />

    <!-- El clic va directo al controlador sin necesidad de setOnClickListener en MainActivity -->
    <Button
        android:id="@+id/btn_calc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/btn_calc"
        android:textSize="22sp"
        android:onClick="@{() -> controlador.alPulsarCalcular()}" />

    <!-- Botón para vaciar el campo, ocultar el resultado y quitar errores -->
    <Button
        android:id="@+id/btn_limpiar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="@string/btn_limpiar"
        android:textSize="20sp"
        android:onClick="@{() -> controlador.alPulsarLimpiar()}" />



</androidx.appcompat.widget.LinearLayoutCompat>
</layout>
